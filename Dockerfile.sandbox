FROM python:3.12-slim
RUN apt update && \
	apt install -y nano curl openssh-server dos2unix && \
	apt clean && rm -rf /var/lib/apt/lists/*
RUN ssh-keygen -A
RUN mkdir -p /run/sshd
COPY --chown=root:root --chmod=644 sshd_config /etc/ssh/sshd_config
RUN useradd -s /bin/bash -d /work agent && passwd -d agent
RUN mkdir -p /etc/ssh/authorized_keys
COPY --chown=agent:agent --chmod=644 id_key.pub /etc/ssh/authorized_keys/agent
COPY --chown=root:root --chmod=700 sandbox-entrypoint.sh /entrypoint.sh
RUN dos2unix /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]